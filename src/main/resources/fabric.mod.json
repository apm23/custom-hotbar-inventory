{
  "schemaVersion": 1,
  "id": "custom_hotbar_inventory",
  "version": "${version}",
  "name": "Custom Hotbar Inventory",
  "description": "Eight-page server-authoritative inventory, alternate hotbar, global sort/merge and direct page selector.",
  "authors": ["apm23"],
  "environment": "*",
  "entrypoints": {
    "main": ["com.anjas.custominventory.CustomHotbarInventory"],
    "client": ["com.anjas.custominventory.client.CustomHotbarInventoryClient"]
  },
  "mixins": [
    {
      "config": "custom_hotbar_inventory.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.158.0+26.2"
  }
}
